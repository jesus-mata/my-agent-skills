#!/bin/sh
# agent-skills — link the skills in this clone into every coding agent on this machine.
#
# Vocabulary (see CONTEXT.md): clone, target, link, shadow, prune.
# The filesystem is the only state: a symlink records its own source, so there is no lockfile.
set -eu

VERSION='0.1.0'
MARK_START='<!-- skills:start -->'
MARK_END='<!-- skills:end -->'

bin_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
CLONE=$(CDPATH='' cd -- "$bin_dir/.." && pwd -P)
SKILLS_DIR="$CLONE/skills"
BACKUP_ROOT="${AGENT_SKILLS_BACKUP_DIR:-$HOME/.agent-skills-backups}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$(printf '\033[0m'); C_DIM=$(printf '\033[2m'); C_RED=$(printf '\033[31m')
  C_YEL=$(printf '\033[33m'); C_GRN=$(printf '\033[32m'); C_BLU=$(printf '\033[1;34m')
else
  C_RESET=''; C_DIM=''; C_RED=''; C_YEL=''; C_GRN=''; C_BLU=''
fi

ERRORS=0
WARNINGS=0

say()   { printf '%s\n' "$*"; }
ok()    { printf '  %s+%s %s\n' "$C_GRN" "$C_RESET" "$*"; }
info()  { printf '  %s.%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
warn()  { WARNINGS=$((WARNINGS + 1)); printf '  %s!%s %s\n' "$C_YEL" "$C_RESET" "$*" >&2; }
oops()  { ERRORS=$((ERRORS + 1)); printf '  %sx%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die()   { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
title() { printf '\n%s%s%s\n' "$C_BLU" "$*" "$C_RESET"; }

# ---------------------------------------------------------------- targets

known_targets() {
  printf '%s\n' \
    "claude|$HOME/.claude/skills" \
    "codex|$HOME/.codex/skills" \
    "cursor|$HOME/.cursor/skills" \
    "gemini|$HOME/.gemini/skills" \
    "opencode|${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills"
}

# Detected = the agent's own directory exists. We never create an agent's home,
# only its skills/ directory inside one that is already there.
selected_targets() {
  if [ -n "$OPT_TARGETS" ]; then
    _old=$IFS; IFS=','
    for _t in $OPT_TARGETS; do
      IFS=$_old
      case $_t in
        */*|~*) printf '%s|%s\n' "$_t" "$_t" ;;
        *)
          _line=$(known_targets | grep "^$_t|" || true)
          [ -n "$_line" ] || die "unknown target '$_t' (known: claude codex cursor gemini opencode, or pass a path)"
          printf '%s\n' "$_line"
          ;;
      esac
      IFS=','
    done
    IFS=$_old
    return 0
  fi
  known_targets | while IFS='|' read -r _name _path; do
    if [ -n "$OPT_ALL" ] || [ -d "$(dirname "$_path")" ]; then
      printf '%s|%s\n' "$_name" "$_path"
    fi
  done
}

# ---------------------------------------------------------------- skills

skills_in_clone() {
  [ -d "$SKILLS_DIR" ] || die "no skills/ directory in $CLONE"
  for _d in "$SKILLS_DIR"/*/; do
    [ -f "$_d/SKILL.md" ] || continue
    _n=${_d%/}
    printf '%s\n' "${_n##*/}"
  done
}

selected_skills() {
  if [ -n "$ARGS" ]; then
    for _n in $ARGS; do
      [ -f "$SKILLS_DIR/$_n/SKILL.md" ] || die "no such skill in this clone: $_n"
      printf '%s\n' "$_n"
    done
  else
    skills_in_clone
  fi
}

frontmatter_field() {
  awk -v field="$2" '
    NR == 1 && $0 != "---" { exit }
    NR == 1 { next }
    $0 == "---" { exit }
    {
      idx = index($0, ":")
      if (idx == 0) next
      key = substr($0, 1, idx - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      if (key != field) next
      val = substr($0, idx + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", val)
      if (val ~ /^".*"$/) val = substr(val, 2, length(val) - 2)
      else if (val ~ /^\047.*\047$/) val = substr(val, 2, length(val) - 2)
      print val
      exit
    }
  ' "$1"
}

# linked | wrong-link | foreign-link | shadow | missing
link_state() {
  _link="$1/$2"
  _src="$SKILLS_DIR/$2"
  if [ -L "$_link" ]; then
    _dst=$(readlink "$_link")
    case $_dst in
      "$_src") printf 'linked\n' ;;
      "$SKILLS_DIR"/*) printf 'wrong-link\n' ;;
      *) printf 'foreign-link\n' ;;
    esac
  elif [ -e "$_link" ]; then
    printf 'shadow\n'
  else
    printf 'missing\n'
  fi
}

sanitize() { printf '%s\n' "$1" | tr '/ ' '__'; }

# ---------------------------------------------------------------- install

link_one() {
  _label=$1; _dir=$2; _name=$3
  _link="$_dir/$_name"
  _src="$SKILLS_DIR/$_name"
  _state=$(link_state "$_dir" "$_name")

  case $_state in
    linked)
      info "$_name already linked"
      ;;
    missing)
      if [ -n "$OPT_DRY" ]; then say "  would link $_name -> $_link"; return 0; fi
      ln -s "$_src" "$_link"
      ok "$_name linked"
      ;;
    wrong-link)
      if [ -n "$OPT_DRY" ]; then say "  would relink $_name"; return 0; fi
      rm "$_link"
      ln -s "$_src" "$_link"
      ok "$_name relinked"
      ;;
    foreign-link)
      _dst=$(readlink "$_link")
      if [ -z "$OPT_FORCE" ]; then
        oops "$_name is a link to $_dst (outside this clone) — rerun with --force to replace it"
        return 0
      fi
      if [ -n "$OPT_DRY" ]; then say "  would replace foreign link $_name (was $_dst)"; return 0; fi
      rm "$_link"
      ln -s "$_src" "$_link"
      ok "$_name relinked (was a link to $_dst)"
      ;;
    shadow)
      if [ -z "$OPT_FORCE" ]; then
        oops "$_name is a real directory here — rerun with --force to back it up and replace it"
        return 0
      fi
      _backup="$BACKUP_ROOT/$STAMP/$(sanitize "$_label")"
      if [ -n "$OPT_DRY" ]; then say "  would back up $_name to $_backup/ and link"; return 0; fi
      mkdir -p "$_backup"
      mv "$_link" "$_backup/$_name"
      ln -s "$_src" "$_link"
      ok "$_name linked (previous directory backed up to $_backup/$_name)"
      ;;
  esac
}

do_install() {
  _skills=$(selected_skills)
  _targets=$(selected_targets)
  [ -n "$_targets" ] || die "no targets detected — install an agent first, or pass --target <path>"

  do_validate_quiet

  _old=$IFS; IFS='
'
  for _entry in $_targets; do
    IFS=$_old
    _label=${_entry%%|*}
    _dir=${_entry#*|}
    title "$_label  ($_dir)"
    if [ ! -d "$_dir" ]; then
      if [ -n "$OPT_DRY" ]; then
        say "  would create $_dir"
      else
        mkdir -p "$_dir"
        info "created $_dir"
      fi
    fi
    for _name in $_skills; do
      link_one "$_label" "$_dir" "$_name"
    done
    IFS='
'
  done
  IFS=$_old
}

# ---------------------------------------------------------------- status

do_status() {
  _skills=$(selected_skills)
  _targets=$(selected_targets)
  say "clone: $CLONE"
  _old=$IFS; IFS='
'
  for _entry in $_targets; do
    IFS=$_old
    _label=${_entry%%|*}
    _dir=${_entry#*|}
    title "$_label  ($_dir)"
    if [ ! -d "$_dir" ]; then
      info "no skills directory yet"
    else
      for _name in $_skills; do
        _state=$(link_state "$_dir" "$_name")
        case $_state in
          linked)       ok   "$_name linked" ;;
          missing)      info "$_name not linked" ;;
          wrong-link)   warn "$_name links to the wrong path in this clone (run: update)" ;;
          foreign-link) warn "$_name links outside this clone: $(readlink "$_dir/$_name")" ;;
          shadow)       warn "$_name is a real directory shadowing this clone" ;;
        esac
      done
      for _e in "$_dir"/*; do
        [ -L "$_e" ] || continue
        _dst=$(readlink "$_e")
        case $_dst in
          "$SKILLS_DIR"/*)
            [ -d "$_dst" ] || warn "$(basename "$_e") is a dangling link into this clone (run: update)"
            ;;
        esac
      done
    fi
    IFS='
'
  done
  IFS=$_old
}

# ---------------------------------------------------------------- uninstall / prune

remove_links() {
  _mode=$1  # all | dangling
  _skills=$(selected_skills)
  _targets=$(selected_targets)
  _old=$IFS; IFS='
'
  for _entry in $_targets; do
    IFS=$_old
    _label=${_entry%%|*}
    _dir=${_entry#*|}
    [ -d "$_dir" ] || { IFS='
'; continue; }
    title "$_label  ($_dir)"
    for _e in "$_dir"/*; do
      [ -L "$_e" ] || continue
      _dst=$(readlink "$_e")
      _base=$(basename "$_e")
      case $_dst in
        "$SKILLS_DIR"/*) ;;
        *) continue ;;
      esac
      if [ "$_mode" = dangling ]; then
        [ -d "$_dst" ] && continue
      else
        # only the selected skills, when the caller narrowed the set
        if [ -n "$ARGS" ]; then
          _match=''
          for _n in $_skills; do [ "$_n" = "$_base" ] && _match=1; done
          [ -n "$_match" ] || continue
        fi
      fi
      if [ -n "$OPT_DRY" ]; then say "  would unlink $_base"; continue; fi
      rm "$_e"
      ok "$_base unlinked"
    done
    IFS='
'
  done
  IFS=$_old
}

do_uninstall() { remove_links all; }
do_prune()     { remove_links dangling; }

# ---------------------------------------------------------------- update

do_update() {
  if [ -d "$CLONE/.git" ] && command -v git >/dev/null 2>&1; then
    title "pulling $CLONE"
    if git -C "$CLONE" pull --ff-only; then :; else
      warn "git pull failed — continuing with the working copy as it is"
    fi
  else
    info "not a git clone — skipping pull"
  fi
  do_install
  title "pruning links to skills that no longer exist"
  _saved_args=$ARGS
  ARGS=''
  do_prune
  ARGS=$_saved_args
}

# ---------------------------------------------------------------- adopt

do_adopt() {
  [ -n "$ARGS" ] || die "usage: agent-skills adopt <skill> [skill...]"
  _targets=$(selected_targets)
  for _name in $ARGS; do
    _found=''
    _count=0
    _old=$IFS; IFS='
'
    for _entry in $_targets; do
      IFS=$_old
      _dir=${_entry#*|}
      if [ -d "$_dir/$_name" ] && [ ! -L "$_dir/$_name" ]; then
        _found=$_dir
        _count=$((_count + 1))
      fi
      IFS='
'
    done
    IFS=$_old

    [ "$_count" -gt 0 ] || die "no target holds a real directory named '$_name' (already adopted? pass --target to widen the search)"
    if [ "$_count" -gt 1 ]; then
      die "'$_name' exists in $_count targets — pass --target to say which one to adopt from"
    fi
    if [ -e "$SKILLS_DIR/$_name" ]; then
      [ -n "$OPT_FORCE" ] || die "skills/$_name already exists in this clone — diff it against $_found/$_name, then rerun with --force"
      if [ -n "$OPT_DRY" ]; then say "  would replace skills/$_name"; else rm -rf "${SKILLS_DIR:?}/${_name:?}"; fi
    fi
    if [ -n "$OPT_DRY" ]; then
      say "  would move $_found/$_name into skills/ and link it back"
      continue
    fi
    mv "$_found/$_name" "$SKILLS_DIR/$_name"
    ok "adopted $_name from $_found"
  done

  # a dry run moved nothing, so there is nothing in the clone to link yet
  if [ -n "$OPT_DRY" ]; then
    say "  would link$ARGS into every selected target"
    return 0
  fi

  # link the newly adopted skills everywhere, then let the user read the diff
  do_install
  say ""
  say "Nothing was committed. Review with: git -C $CLONE status"
}

# ---------------------------------------------------------------- validate

validate_skill() {
  _name=$1
  _dir="$SKILLS_DIR/$_name"
  _file="$_dir/SKILL.md"

  [ -f "$_file" ] || { oops "$_name: no SKILL.md"; return 0; }

  if [ "$(head -n 1 "$_file")" != "---" ]; then
    oops "$_name: SKILL.md does not start with a --- frontmatter block"
    return 0
  fi
  if ! awk 'NR > 1 && $0 == "---" { found = 1; exit } END { exit !found }' "$_file"; then
    oops "$_name: frontmatter block is never closed"
    return 0
  fi

  _fm_name=$(frontmatter_field "$_file" name)
  if [ -z "$_fm_name" ]; then
    oops "$_name: frontmatter has no 'name'"
  elif [ "$_fm_name" != "$_name" ]; then
    oops "$_name: frontmatter name is '$_fm_name' but the directory is '$_name'"
  fi

  _desc=$(frontmatter_field "$_file" description)
  if [ -z "$_desc" ]; then
    oops "$_name: frontmatter has no 'description' — agents use it to decide when to load the skill"
  elif [ "${#_desc}" -lt 20 ]; then
    warn "$_name: description is only ${#_desc} characters — say when to use the skill, not just what it is"
  fi

  # relative file references must resolve
  grep -oE '\]\([^)#][^)]*\)' "$_file" 2>/dev/null | sed 's/^](//; s/)$//' | while read -r _ref; do
    case $_ref in
      http*|mailto:*|'#'*|/*) continue ;;
    esac
    _ref=${_ref%%#*}
    [ -n "$_ref" ] || continue
    [ -e "$_dir/$_ref" ] || printf 'MISSING_REF %s\n' "$_ref"
  done > "$TMP_REFS"
  while read -r _tag _ref; do
    [ "$_tag" = MISSING_REF ] || continue
    oops "$_name: SKILL.md references $_ref which does not exist"
  done < "$TMP_REFS"

  # /slash references to skills that are not in this repo are portability holes
  grep -oE '(^|[ `(])/[a-z][a-z0-9-]+' "$_file" 2>/dev/null | sed 's/^[ `(]//' | sort -u | while read -r _slash; do
    _ref=${_slash#/}
    case " $DENY_SLASH " in *" $_ref "*) continue ;; esac
    [ -d "$SKILLS_DIR/$_ref" ] && continue
    printf 'UNKNOWN_SLASH %s\n' "$_ref"
  done > "$TMP_SLASH"
  while read -r _tag _ref; do
    [ "$_tag" = UNKNOWN_SLASH ] || continue
    warn "$_name: refers to /$_ref, which is not a skill in this repo — it will dangle wherever that skill is not installed"
  done < "$TMP_SLASH"
}

DENY_SLASH='tmp usr etc bin var opt dev home users mnt srv root sbin lib proc sys api dist src node-modules'

do_validate() {
  title "validating skills in $SKILLS_DIR"
  for _n in $(selected_skills); do
    validate_skill "$_n"
  done
  if [ "$ERRORS" -eq 0 ]; then
    ok "$(selected_skills | wc -l | tr -d ' ') skills valid ($WARNINGS warnings)"
  fi
}

# install runs validation but never lets a bad skill stop the good ones
do_validate_quiet() {
  _before=$ERRORS
  for _n in $(selected_skills); do
    validate_skill "$_n"
  done
  if [ "$ERRORS" -gt "$_before" ]; then
    warn "validation found problems (above) — linking anyway; run 'agent-skills validate' for the full report"
    ERRORS=$_before
  fi
}

# ---------------------------------------------------------------- readme

do_readme() {
  _readme="$CLONE/README.md"
  [ -f "$_readme" ] || die "no README.md in $CLONE"
  grep -qF "$MARK_START" "$_readme" || die "README.md has no '$MARK_START' marker"
  grep -qF "$MARK_END" "$_readme" || die "README.md has no '$MARK_END' marker"

  _tbl=$(mktemp)
  _out=$(mktemp)
  {
    printf '\n| Skill | What it does |\n| --- | --- |\n'
    for _n in $(skills_in_clone); do
      _d=$(frontmatter_field "$SKILLS_DIR/$_n/SKILL.md" description | sed 's/|/\\|/g')
      # shellcheck disable=SC2016  # backticks are markdown, not a subshell
      printf '| [`%s`](skills/%s/SKILL.md) | %s |\n' "$_n" "$_n" "$_d"
    done
    printf '\n'
  } > "$_tbl"

  awk -v s="$MARK_START" -v e="$MARK_END" -v f="$_tbl" '
    $0 == s { print; while ((getline line < f) > 0) print line; skip = 1; next }
    $0 == e { skip = 0 }
    !skip { print }
  ' "$_readme" > "$_out"
  mv "$_out" "$_readme"
  rm -f "$_tbl"
  ok "README.md skill table regenerated"
}

# ---------------------------------------------------------------- help

do_help() {
  cat <<'EOF'
agent-skills — link this repo's skills into every coding agent on this machine.

USAGE
  bin/agent-skills <command> [skill...] [flags]

COMMANDS
  install [skill...]    Link skills into every detected target.
  update                git pull, relink, then prune links to skills that are gone.
  status                Show what is linked, missing, shadowed or dangling.
  uninstall [skill...]  Remove links that point into this clone. Nothing else is touched.
  adopt <skill>         Move a real skill directory out of an agent into this clone, then link it back.
  validate [skill...]   Check frontmatter, file references and cross-skill references.
  readme                Regenerate the skill table in README.md.
  help, version

FLAGS
  --target <list>   Comma-separated target names (claude, codex, cursor, gemini, opencode)
                    or absolute paths to any other agent's skills directory.
  --all             Include known targets even when that agent is not installed here.
  --force, -f       Replace a shadowing directory (backed up first) or a foreign link.
  --dry-run, -n     Print what would happen and change nothing.

ENVIRONMENT
  AGENT_SKILLS_HOME         Where the bootstrap clones to (default ~/.agent-skills).
  AGENT_SKILLS_BACKUP_DIR   Where shadowed directories are backed up (default ~/.agent-skills-backups).

Skills are linked, never copied: edit a skill in this clone and every agent sees the change.
EOF
}

# ---------------------------------------------------------------- main

CMD=${1:-help}
[ $# -gt 0 ] && shift
OPT_TARGETS=''
OPT_ALL=''
OPT_FORCE=''
OPT_DRY=''
ARGS=''

while [ $# -gt 0 ]; do
  case $1 in
    --target) [ $# -ge 2 ] || die "--target needs a value"; OPT_TARGETS=$2; shift 2 ;;
    --target=*) OPT_TARGETS=${1#--target=}; shift ;;
    --all) OPT_ALL=1; shift ;;
    --force|-f) OPT_FORCE=1; shift ;;
    --dry-run|-n) OPT_DRY=1; shift ;;
    -h|--help) CMD=help; shift ;;
    -*) die "unknown flag: $1" ;;
    *) ARGS="$ARGS $1"; shift ;;
  esac
done

STAMP=$(date +%Y%m%d-%H%M%S)
TMP_REFS=$(mktemp)
TMP_SLASH=$(mktemp)
trap 'rm -f "$TMP_REFS" "$TMP_SLASH"' EXIT INT TERM

case $CMD in
  install)   do_install ;;
  update)    do_update ;;
  status)    do_status ;;
  uninstall) do_uninstall ;;
  adopt)     do_adopt ;;
  validate)  do_validate ;;
  prune)     do_prune ;;
  readme)    do_readme ;;
  version|--version) say "agent-skills $VERSION" ;;
  help)      do_help ;;
  *)         die "unknown command '$CMD' — try: bin/agent-skills help" ;;
esac

say ""
if [ "$ERRORS" -gt 0 ]; then
  printf '%s%s error(s)%s, %s warning(s)\n' "$C_RED" "$ERRORS" "$C_RESET" "$WARNINGS" >&2
  exit 1
fi
exit 0
