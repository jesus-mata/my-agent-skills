#!/usr/bin/env python3
"""Launcher for herdr-spec-engine: runs spec_engine.cli from this skill folder."""
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("herdr-spec-engine needs Python 3.11+, found %d.%d\n" % sys.version_info[:2])
    sys.exit(2)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from spec_engine.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
